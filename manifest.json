{
  "manifest_version": 3,
  "name": "Platform Spoofer",
  "version": "0.4.0",
  "description": "User-Agent / Client Hints（platform）を任意のプロファイルに偽装する汎用拡張機能です",
  "permissions": ["storage", "tabs", "scripting", "declarativeNetRequestWithHostAccess"],
  "optional_host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Platform Spoofer"
  },
  "background": {
    "service_worker": "background.js"
  }
}
